# Скопировать в .env.local и подкорректировать под локальную среду.
# .env.local в .gitignore - креды не уйдут в репо.

# Базовый URL бэкенд API
VITE_API_URL=http://localhost:9090

# UUID текущего пользователя (временно, до Этапа 6 - см. ADR-006)
# Создать запись в users на беке и подставить её UUID сюда
VITE_DEV_USER_ID=00000000-0000-0000-0000-000000000000
