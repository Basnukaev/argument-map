<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>ru.basnukaev</groupId>
	<artifactId>argument-map</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Argument Map</name>
	<description>API-first argument mapping tool</description>
	<properties>
		<java.version>21</java.version>
		<aws.sdk.version>2.44.4</aws.sdk.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<!--
				AWS SDK for Java v2 bom-import (ADR-024). Object storage слой
				через S3-compatible API - работает с MinIO/R2/B2/Yandex/AWS S3.
				Bom фиксирует версии всех модулей AWS SDK консистентно.
			-->
			<dependency>
				<groupId>software.amazon.awssdk</groupId>
				<artifactId>bom</artifactId>
				<version>${aws.sdk.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!--
			Vision 49d Observability Phase 1 (ADR-051): structured logging
			JSON encoder для prod profile. В dev/local/test остаётся text
			console pattern. См. logback-spring.xml + spec
			docs/superpowers/specs/2026-05-20-observability-design.md
		-->
		<dependency>
			<groupId>net.logstash.logback</groupId>
			<artifactId>logstash-logback-encoder</artifactId>
			<version>7.4</version>
		</dependency>
		<!--
			Resilience4j circuit breaker для upstream HTTP вызовов (ADR-024 25.b).
			Защищает archive.org PDF downloads + shamela API от cascading failures.
			AOP включается через resilience4j-spring-boot3 starter +
			spring-boot-starter-aop transitively.
		-->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-spring-boot3</artifactId>
			<version>2.2.0</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
		</dependency>
		<dependency>
			<groupId>org.liquibase</groupId>
			<artifactId>liquibase-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.8.0</version>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!--
			SQLite JDBC для чтения транзитных архивов shamela API (ADR-020).
			Используется только в library.shamela.etl - подключение к .sqlite-файлам
			через DriverManager.getConnection("jdbc:sqlite:..."), без вмешательства
			в основной DataSource Postgres. После ETL файлы удаляются.
		-->
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<version>3.45.3.0</version>
		</dependency>
		<!--
			MySQL JDBC для чтения дампа sunnah.com (ADR-052, Phase 5 шаг 2.d).
			Используется только в hadith.sunnah.etl.SunnahDumpReader - подключение
			к загруженному MySQL-дампу (github.com/sunnah-com/api) через
			DriverManager, без вмешательства в основной DataSource Postgres.
			Version managed by Spring Boot BOM. Симметрично sqlite-jdbc для shamela.
		-->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!--
			AWS SDK v2 S3 client (ADR-024). Version managed by bom-import выше.
			Используется в library.storage.S3ClientConfig для подключения к
			MinIO (dev) / любому S3-compatible сервису (prod).
		-->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
		</dependency>
		<!--
			Apache PDFBox 3.x (ADR-035) - page-by-page text extraction + PDF
			metadata. Используется library.imports.FileImportService для Этапа 16
			(user-uploaded PDF). Альтернатива Apache Tika рассмотрена и отклонена -
			Tika удобнее для metadata, но не даёт прямого phys-page → text mapping
			которое нужно нашей доменной модели lib_pages (одна запись на одну
			физическую страницу PDF). PDFBox 3.x использует новый Loader API
			вместо deprecated PDDocument.load().
		-->
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.5</version>
		</dependency>
		<!--
			URL connection HTTP client - lightweight blocking реализация для
			синхронного S3 client. AWS SDK v2 default - netty (async/reactive),
			тяжелее. Для нашего use-case (synchronous put/get с Range) хватает
			URL connection-client.
		-->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>url-connection-client</artifactId>
		</dependency>
		<!--
			Tess4j (ADR-041) - Java JNA wrapper над Tesseract C++ для OCR
			арабских/русских сканов рукописей. Tesseract сам - system
			dependency, нужно установить отдельно (см. backend/CLAUDE.md
			раздел OCR): на Debian/WSL2 `sudo apt install tesseract-ocr
			tesseract-ocr-ara tesseract-ocr-rus`. Tess4j подключает native
			через JNA. Используется в library.imports.OcrService для Этапа 17.b.
		-->
		<dependency>
			<groupId>net.sourceforge.tess4j</groupId>
			<artifactId>tess4j</artifactId>
			<version>5.13.0</version>
			<exclusions>
				<!--
					tess4j тащит slf4j-simple в compile-scope - конфликтует
					с logback-classic из spring-boot-starter (multi-binding
					warning + непредсказуемый routing log'ов). Исключаем.
				-->
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-simple</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!--
			Spring Security 6.x (ADR-040). Версия managed Spring Boot 3.5 BOM.
			Дёргает за собой spring-security-config / -core / -web.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!--
			jjwt 0.12.x (ADR-040) - современный JWT API, разделён на три
			артефакта: api (compile-time), impl и jackson (runtime). Так
			библиотека позволяет swap implementation без затрагивания кода.
		-->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			Spring Security test helpers (with(jwt()), with(user())) для
			MockMvc интеграционных тестов AuthControllerIT + других IT
			которым нужен SecurityContext без реального JWT-flow.
		-->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			Testcontainers MySQL (ADR-052). Поднимает MySQL container в IT для
			SunnahDumpReader - читает дамп sunnah.com из реальной MySQL-схемы
			(fixture в src/test/resources/sunnah). Изолированно от Postgres-
			контейнера основных IT. Version managed by Spring Boot BOM.
		-->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>mysql</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			Testcontainers MinIO module (ADR-024). Поднимает MinIO container в
			IT для ObjectStorageService - изолированно от docker-compose MinIO
			на :9000. Каждый IT-класс получает свежий container с empty bucket'ами.
		-->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>minio</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<profiles>
						<profile>local</profile>
					</profiles>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<!--
						JUnit5-теги исключаемые из обычного `./mvnw verify`.
						"live" - тесты требующие реальный интернет/внешний сервис
						(например, ShamelaApiClientLiveIT против dev.shamela.ws).
						Запуск live-тестов: ./mvnw failsafe:integration-test -Dgroups=live
					-->
					<excludedGroups>live</excludedGroups>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!--
				JaCoCo - line/branch coverage report. Подключается агентом
				к surefire/failsafe (prepare-agent + prepare-agent-integration),
				объединяет результаты unit + IT в один отчёт через `report`
				цель на фазе verify. Отчёт - target/site/jacoco/index.html.
				Без enforcement (build не падает на низком coverage) - audit-only
				инструмент.
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.12</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>prepare-agent-integration</id>
						<goals>
							<goal>prepare-agent-integration</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
