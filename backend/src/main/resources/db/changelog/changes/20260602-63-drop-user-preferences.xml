<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Удаляем user_preferences целиком - вся вертикаль user-preferences
        признана мёртвой (решение владельца). Frontend preferencesStore
        хранил 5 значений, все убираются: hideTashkeelByDefault /
        transliteration / bilingualMode (мусор), textSize (мертво,
        дублирует UI scale), arabicFont (мертвый дубль). Бэкенд-стек
        (контроллер/сервис/репозиторий/DTO + IT) удалён вместе с таблицей.

        rollback воссоздаёт таблицу из миграции 42 (на случай отката).
    -->
    <changeSet id="20260602-63-drop-user-preferences" author="Abdula Basnukaev">
        <comment>Удаляем user_preferences - вся фича preferences мертва</comment>
        <sql>DROP TABLE IF EXISTS user_preferences</sql>
        <rollback>
            <sql>
                CREATE TABLE user_preferences (
                    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
                    user_id uuid NOT NULL REFERENCES users(id) ON DELETE CASCADE,
                    key varchar(100) NOT NULL,
                    value jsonb NOT NULL,
                    updated_at timestamptz NOT NULL DEFAULT now(),
                    UNIQUE (user_id, key)
                );
                CREATE INDEX idx_user_preferences_user ON user_preferences(user_id);
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
